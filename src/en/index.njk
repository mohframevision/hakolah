{% set t = i18n[lang or "ar"] %}
<section class="hero">
  <h1>Everything useful… in one place</h1>
  <p>Links and tools, restaurants, stores, cafes, bakeries, and places — gathered and organized to save you time.</p>
  <p class="hero-stats" id="siteStatsLine"></p>
</section>

<section class="home-carousel-section">
  <div class="home-carousel" id="homeCarousel"></div>
  <div class="text-center">
    <button type="button" class="btn secondary notify-toggle hidden" id="notifyToggle">
      🔕 Notify me daily
    </button>
  </div>
</section>

<div class="explore-progress" id="exploreProgress"></div>

<section class="section-grid">
  {% for entry in sections %}
  <a class="section-card" data-section="{{ entry.slug }}" href="{{ ('/en/' + entry.slug + '.html') | url }}">
    <span class="icon">{{ entry.icon }}</span>
    <h3>{{ entry.title_en }}</h3>
    <p>{{ entry.description_en }}</p>
  </a>
  {% endfor %}
  {# "Day Plan" card hidden for now — the feature needs a better algorithm
     (see the note at the top of src/plan.njk). The page itself still works
     via its direct URL for testing. #}
  <a class="section-card" href="{{ '/en/favorites.html' | url }}">
    <span class="icon">❤️</span>
    <h3>{{ t.home_favorites_title }}</h3>
    <p>{{ t.home_favorites_desc }}</p>
  </a>
</section>

