<div class="dilmo">
  <div class="dilmo-top">
    <h1>Dilmo</h1>
    <div class="cast">
      <span class="ctl-label" id="cast-label">Characters</span>
      <div class="seg" id="cast-list" role="group" aria-labelledby="cast-label"></div>
      <button type="button" class="snd" id="cast-solo">Just me</button>
      <button type="button" class="snd" id="cast-all">Bring everyone back</button>
    </div>
    <div class="cast">
      <button type="button" class="snd" id="snd" aria-pressed="true">Sound: on</button>
      <button type="button" class="snd" id="photo-btn">Take a photo</button>
    </div>
  </div>

  <div class="play" id="play">
    <div class="world" id="world">
      <div class="sky" id="sky" aria-hidden="true"></div>
      <span class="clock" id="clock"></span>
      <div class="bench" id="bench" aria-hidden="true"></div>
      <div class="bush" id="bush0" aria-hidden="true"></div>
      <div class="bush" id="bush1" aria-hidden="true"></div>
      <button type="button" class="ball" id="ball" aria-label="A ball, tap it to kick"></button>
      <div class="foods" id="foods">
        <button type="button" class="food" id="food-burger" data-food="burger">burger</button>
        <button type="button" class="food" id="food-karak" data-food="karak">karak</button>
        <button type="button" class="food" id="food-samosa" data-food="samosa">samosa</button>
      </div>
      <div class="orb-shadow" id="orb-shadow"></div>
      <p class="orb-say" id="orb-say" aria-live="polite" hidden></p>
      <svg id="orb" class="orb" viewBox="-70 -70 140 140" role="img" aria-label="Dilmo: poke him, drag him, throw him">
        <defs>
          <radialGradient id="pg-rg" cx="38%" cy="32%" r="75%"><stop offset="0" class="s-hi"/><stop offset=".55" class="s-mid"/><stop offset="1" class="s-lo"/></radialGradient>
          <filter id="pg-gn" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency="0.95" numOctaves="3" seed="7" stitchTiles="stitch"/><feColorMatrix type="matrix" values=".33 .33 .33 0 0 .33 .33 .33 0 0 .33 .33 .33 0 0 0 0 0 0 1"/><feComposite in2="SourceGraphic" operator="in"/></filter>
          <filter id="pg-sf" x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="1"/></filter>
        </defs>
        <g class="pb">
          <path class="pbody" d="M48 0A48 48 0 1 1 -48 0A48 48 0 1 1 48 0Z" fill="url(#pg-rg)" filter="url(#pg-sf)"/>
          <path class="grain pgrain" d="M48 0A48 48 0 1 1 -48 0A48 48 0 1 1 48 0Z" transform="scale(.97)" filter="url(#pg-gn)"/>
          <g class="pf">
            <ellipse class="pe" cx="-15" cy="-4" rx="6.4" ry="9.1"/>
            <ellipse class="pe" cx="15" cy="-4" rx="6.4" ry="9.1"/>
            <ellipse class="pm" cx="0" cy="18" rx="4.3" ry="5.7"/>
          </g>
        </g>
      </svg>
    </div>
  </div>

  <div class="player-panel" id="player-panel">
    <h2>Join them as your own character</h2>
    <div class="pp-row"><label for="pp-name">Name</label><input id="pp-name" maxlength="12" placeholder="e.g. Noor" autocomplete="off"></div>
    <div class="pp-row"><span>Colour</span><div class="swatches" id="pp-colors" role="group" aria-label="Your character's colour"></div></div>
    <div class="pp-row"><span>Size</span><div class="seg" id="pp-size" role="group" aria-label="Your character's size">
      <button type="button" id="pp-s0" data-s="0" aria-pressed="false">Small</button><button type="button" id="pp-s1" data-s="1" aria-pressed="true">Medium</button><button type="button" id="pp-s2" data-s="2" aria-pressed="false">Large</button>
    </div></div>
    <button type="button" class="game-btn" id="pp-join">Join</button>
  </div>
  <div class="player-ui" id="player-ui" hidden>
    <div class="pp-pad" role="group" aria-label="Move" dir="ltr">
      <div class="seg"><button type="button" id="pp-left" aria-label="Left">◀</button><button type="button" id="pp-right" aria-label="Right">▶</button></div>
      <div class="seg"><button type="button" id="pp-down" aria-label="Down">▼</button><button type="button" id="pp-jump">Jump</button></div>
    </div>
    <span class="game-status" id="pp-hud" aria-live="polite"></span>
    <div class="pp-controls">
      <div class="seg">
        <button type="button" id="pp-wave">Wave</button><button type="button" id="pp-laugh">Laugh</button><button type="button" id="pp-call">Call them</button>
      </div>
      <div class="swatches" id="pp-recolor" role="group" aria-label="Change your colour"></div>
      <form class="pp-chat" id="pp-chat"><input id="pp-msg" maxlength="60" placeholder="Say something to them…" autocomplete="off" aria-label="Your message"><button type="submit" class="game-btn" id="pp-send">Send</button></form>
      <button type="button" class="snd" id="pp-leave">Leave</button>
    </div>
  </div>
  <p class="tips">Tap Dilmo or drag and throw him, drag food into his mouth, and kick the ball. The world follows Bahrain time, and the stars you collect unlock new colours for your character. Everything you do is saved in your browser only.</p>

  <div class="photo-modal" id="photo-modal" hidden>
    <figure>
      <img id="photo-img" alt="A photo of the scene">
      <figcaption>
        <a class="game-btn" id="photo-save" download="hakolah-dilmo.png" href="#">Save the photo</a>
        <button type="button" class="snd" id="photo-close">Close</button>
      </figcaption>
    </figure>
  </div>
</div>
