        <button type="button" class="filter-chip" id="beepOctUp" aria-label="Octave up">X ⬆️</button>
        <button type="button" class="filter-chip" id="beepFullscreen" hidden aria-label="Fullscreen">⛶</button>
      </div>
      <div class="beep-play-keys" id="beepPlayKeys"></div>
      <div class="beep-rec-take" id="beepRecTake" hidden data-layer="Layer" data-max="Maximum 8 layers" data-silent="All layers are muted">
        <div class="beep-clip-tools" id="beepClipTools">
          <button type="button" class="filter-chip" id="beepToolSplit" disabled data-cut="Select a clip, place the white line inside it by clicking the ruler, then press Split.">✂️ Split</button>
          <button type="button" class="filter-chip" id="beepToolCopy" disabled>⧉ Duplicate</button>
          <button type="button" class="filter-chip" id="beepToolMute" disabled data-mute="🔇 Mute" data-unmute="🔊 Unmute">🔇 Mute</button>
