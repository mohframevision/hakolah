---
layout: base.njk
permalink: "search.html"
title: "البحث | هكوله"
description: "ابحث في هكوله عن مطعم أو طبق أو كافيه أو كراج: في أسماء الأماكن والمنيو والأسعار، بالعربية أو بالإنجليزية."
navActive: "search"
pageScript: "search"
langSwitchUrl: "/en/search.html"
---
{% from "icon.njk" import icon %}
<div class="search-page">
  <h1 class="sr-only">🔍 {{ i18n.ar.nav_search }}</h1>
  <form class="search-box" id="searchForm" role="search" action="{{ '/search.html' | url }}">
    <span class="search-box-icon">{{ icon("search", 20) }}</span>
    <input type="search" name="q" id="searchInput" placeholder="{{ i18n.ar.search_placeholder }}" aria-label="{{ i18n.ar.search_aria }}" autocomplete="off" enterkeyhint="search" />
    <button type="button" class="search-mic" id="searchMic" hidden aria-label="{{ i18n.ar.search_mic }}" title="{{ i18n.ar.search_mic }}">{{ icon("mic", 20) }}</button>
  </form>
  <p class="search-status" id="searchStatus" role="status" aria-live="polite"></p>

  <div id="searchEmpty">
    <div class="search-block" id="searchRecentBlock" hidden>
      <div class="search-head"><h2>{{ i18n.ar.search_recent }}</h2><button type="button" class="link-btn" id="searchRecentClear">{{ i18n.ar.search_clear }}</button></div>
      <ul class="search-recent" id="searchRecent"></ul>
      <p class="search-note">{{ i18n.ar.search_recent_note }}</p>
    </div>
    <div class="search-block">
      <h2>{{ i18n.ar.search_popular }}</h2>
      <div class="chip-row" id="searchPopular"></div>
    </div>
    <div class="search-block">
      <h2>{{ i18n.ar.search_try }}</h2>
      <div class="chip-row" id="searchTry"></div>
    </div>
    <div class="search-block">
      <h2>{{ i18n.ar.search_browse }}</h2>
      <div class="mini-sections">
        {% for entry in sections %}
        <a class="mini-section" href="{{ ('/' + entry.slug + '.html') | url }}"><span>{{ entry.icon }}</span>{{ entry.navLabel }}</a>
        {% endfor %}
      </div>
    </div>
  </div>

  <div id="searchResults" hidden>
    <div class="search-tabs" role="tablist" id="searchTabs"></div>
    <div class="chip-row" id="searchSort"></div>
    <div id="searchList" role="tabpanel"></div>
  </div>
</div>
