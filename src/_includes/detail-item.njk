---
layout: base.njk
---
{% set lang = lang or "ar" %}
{% set t = i18n[lang] %}
{% set homeUrl = ('/en/index.html' if lang == 'en' else '/index.html') %}
{% set sectionUrl = (('/en/' if lang == 'en' else '/') + sectionSlug + '.html') %}
<div class="breadcrumb"><a href="{{ homeUrl | url }}">{{ t.nav_home }}</a> / <a href="{{ sectionUrl | url }}">{{ sectionTitle }}</a> / {{ title }}</div>
{% if image %}<img class="detail-hero-photo" src="{{ image }}" alt="{{ title }}" />{% endif %}
<section class="page-header">
  <h1>{{ icon }} {{ title }}</h1>
  {# الدليل عند لحظة القرار: نفس شارات البطاقة، فوق زر الخريطة #}
  {% set src = page if (verified or liked) else ((collections.all | pageByUrl(langSwitchUrl)).data if lang == 'en' else page) %}
  {% set v = verified or (src and src.verified) %}{% set lk = liked or (src and src.liked) %}
  {% if v or lk %}<p class="detail-badges">{% if v %}<span class="verified-badge">{{ t.verified_badge }}</span>{% endif %} {% if lk %}<span class="liked-badge">{{ t.liked_badge }}</span>{% endif %}</p>{% endif %}
  <div class="page-header-actions">
    {# الهدف الأول لزائر صفحة مكان: يروح له — فالخريطة الزر الأساسي والباقي ثانوي #}
    {% set mapsLink = links.maps if (links and links.maps) else (content | mapsUrl) %}
    {% if mapsLink %}<a class="btn" href="{{ mapsLink }}" target="_blank" rel="noopener">📍 {{ t.link_maps }}</a>{% endif %}
    {% if audio %}
    <button type="button" class="btn secondary article-listen-btn" data-audio-src="{{ audio | url }}">🔊 {{ t.article_listen }}</button>
    <audio class="article-audio-player hidden" controls preload="none"></audio>
    {% endif %}
    <button type="button" class="btn secondary article-share-btn">📤 {{ t.article_share }}</button>
  </div>
</section>
{% if aiDisclosure %}
{# قسم "تجارب الذكاء الاصطناعي" ألعاب/تجارب استكشافية، مو مقالات معلوماتية —
   إخلاء المسؤولية القانوني (guide_disclaimer) مصمم لمقال يحتوي معلومات
   يُعتمَد عليها، فما ينطبق هنا ويعطي انطباع رسمي زايد عن حجم الشي #}
<div class="banner-note ai-disclosure">🤖 {{ aiDisclosure }}{% if sectionSlug != "ai-experiments" %} {{ t.guide_disclaimer }}{% endif %}</div>
{% endif %}
{% if video %}
<div class="detail-video">
  <iframe
    src="https://www.youtube-nocookie.com/embed/{{ video }}"
    title="{{ title }}"
    loading="lazy"
    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>
{% endif %}
{% if recommendation %}
<blockquote class="recommend-quote">{{ recommendation }}</blockquote>
{% endif %}
{# صفحات الأدوات (لا المقالات) تحتاج عرض الحاوية كامل: فيها لوحات وشبكات
   وجداول لا نصاً يُقرأ، وحصرها بعرض النص يضيّع نصف الشاشة بالكمبيوتر #}
<article class="prose{% if wideLayout %} prose-wide{% endif %}">
{{ content | safe }}
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | json | safe }},
  "description": {{ desc | json | safe }},
  "inLanguage": "{{ lang }}",
  {% if image %}"image": {{ (site.origin + image) | json | safe }},{% endif %}
  "isPartOf": {
    "@type": "WebSite",
    "name": {{ site.name | json | safe }},
    "url": {{ (site.origin + ('/index.html' | url)) | json | safe }}
  }
}
</script>
