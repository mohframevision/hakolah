---
layout: base.njk
---
<div class="breadcrumb"><a href="{{ '/index.html' | url }}">الرئيسية</a> / <a href="{{ ('/' + sectionSlug + '.html') | url }}">{{ sectionTitle }}</a> / {{ title }}</div>
{% if image %}<img class="detail-hero-photo" src="{{ image }}" alt="{{ title }}" />{% endif %}
<section class="page-header">
  <h1>{{ icon }} {{ title }}</h1>
</section>
<article class="prose">
{{ content | safe }}
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | json | safe }},
  "description": {{ desc | json | safe }},
  "inLanguage": "ar",
  {% if image %}"image": {{ (site.origin + image) | json | safe }},{% endif %}
  "isPartOf": {
    "@type": "WebSite",
    "name": {{ site.name | json | safe }},
    "url": {{ (site.origin + ('/index.html' | url)) | json | safe }}
  }
}
</script>
