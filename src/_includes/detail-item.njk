---
layout: base.njk
---
{% set lang = lang or "ar" %}
{% set t = i18n[lang] %}
{% set homeUrl = ('/en/index.html' if lang == 'en' else '/index.html') %}
{% set sectionUrl = (('/en/' if lang == 'en' else '/') + sectionSlug + '.html') %}
<div class="breadcrumb"><a href="{{ homeUrl | url }}">{{ t.nav_home }}</a> / <a href="{{ sectionUrl | url }}">{{ sectionTitle }}</a> / {{ title }}</div>
{% if image %}<img class="detail-hero-photo" src="{{ image }}" alt="{{ title }}" />{% endif %}
<section class="page-header">
  <h1>{{ icon }} {{ title }}</h1>
</section>
<article class="prose">
{{ content | safe }}
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | json | safe }},
  "description": {{ desc | json | safe }},
  "inLanguage": "{{ lang }}",
  {% if image %}"image": {{ (site.origin + image) | json | safe }},{% endif %}
  "isPartOf": {
    "@type": "WebSite",
    "name": {{ site.name | json | safe }},
    "url": {{ (site.origin + ('/index.html' | url)) | json | safe }}
  }
}
</script>
