{% set lang = lang or "ar" %}
{% set t = i18n[lang] %}
<div class="site-promo-slot cazasouq-promo">
  <span class="cazasouq-promo-label">{{ t.promo_ad_label }}</span>
  <div class="cazasouq-promo-body">
    <span class="cazasouq-promo-icon">🎮</span>
    <div class="cazasouq-promo-text">
      <h3>{{ t.promo_cazasouq_title }}</h3>
      <p>{{ t.promo_cazasouq_desc }}</p>
    </div>
  </div>
  <div class="cazasouq-promo-links">
    <a class="btn" href="https://cazasouq.idevaffiliate.com/692.html" target="_blank" rel="noopener noreferrer sponsored">🛒 {{ t.promo_shop_now }}</a>
    <a class="btn secondary" href="https://cazasouq.idevaffiliate.com/idevaffiliate.php?id=692&url=741" target="_blank" rel="noopener noreferrer sponsored">🎧 {{ t.promo_devo_headphones }}</a>
    <a class="btn secondary" href="https://cazasouq.idevaffiliate.com/idevaffiliate.php?id=692&url=705" target="_blank" rel="noopener noreferrer sponsored">🪑 {{ t.promo_gaming_tables }}</a>
  </div>
  {# الإفصاح يبقى ظاهراً: تحويل رابط بعمولة ليبدو ترشيحاً عضوياً تضليل
     للزائر، ويناقض مصداقية الموقع نفسها. الحل: دفء الترشيح + إفصاح صريح #}
  <p class="cazasouq-promo-note">{{ t.promo_affiliate_note }}</p>
</div>
