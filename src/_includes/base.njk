<!DOCTYPE html>
{% set lang = lang or "ar" %}
{% set t = i18n[lang] %}
<html lang="{{ lang }}" dir="{{ 'ltr' if lang == 'en' else 'rtl' }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>
    (function () {
      try {
        var pref = localStorage.getItem("site_theme_pref");
        if (pref === "light" || pref === "dark") {
          document.documentElement.setAttribute("data-theme", pref);
        }
      } catch (e) {}
    })();
  </script>
  {% set metaDescription = description or desc %}
  {% set pageUrl = site.origin + (page.url | url) %}
  {% set ogType = "article" if sectionSlug else "website" %}
  {% set ogImageUrl = site.origin + image if image else site.origin + ('/assets/og-image.png' | url) %}
  <title>{{ title }}</title>
  {% if metaDescription %}<meta name="description" content="{{ metaDescription }}" />{% endif %}
  {% if noindex %}<meta name="robots" content="noindex, nofollow" />{% endif %}
  <link rel="canonical" href="{{ pageUrl }}" />
  <meta name="theme-color" content="#2563eb" />

  <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}" />
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/favicon-32x32.png' | url }}" />
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/favicon-16x16.png' | url }}" />
  <link rel="shortcut icon" href="{{ '/assets/favicon.ico' | url }}" />
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/apple-touch-icon.png' | url }}" />
  <link rel="manifest" href="{{ '/assets/site.webmanifest' | url }}" />

  <meta property="og:type" content="{{ ogType }}" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:locale" content="{{ site.locale }}" />
  <meta property="og:url" content="{{ pageUrl }}" />
  <meta property="og:title" content="{{ title }}" />
  {% if metaDescription %}<meta property="og:description" content="{{ metaDescription }}" />{% endif %}
  <meta property="og:image" content="{{ ogImageUrl }}" />
  {% if not image %}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {% endif %}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  {% if metaDescription %}<meta name="twitter:description" content="{{ metaDescription }}" />{% endif %}
  <meta name="twitter:image" content="{{ ogImageUrl }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}?v={{ buildVersion }}" />
  {% if adsense.publisherId %}
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ adsense.publisherId }}" crossorigin="anonymous"></script>
  {% endif %}
  {% if analytics.measurementId %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ analytics.measurementId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag("js", new Date());
    gtag("config", "{{ analytics.measurementId }}");
  </script>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": {{ site.name | json | safe }},
        "url": {{ (site.origin + ('/index.html' | url)) | json | safe }},
        "inLanguage": "ar"
      },
      {
        "@type": "Organization",
        "name": {{ site.name | json | safe }},
        "url": {{ (site.origin + ('/index.html' | url)) | json | safe }},
        "logo": {{ (site.origin + ('/assets/android-chrome-512x512.png' | url)) | json | safe }}
      }
    ]
  }
  </script>
</head>
<body>

  <a href="#main-content" class="skip-link">{{ t.skip_to_content }}</a>

  <header class="site-header">
    <div class="header-inner">
      <a href="{{ (('/en/index.html' if lang == 'en' else '/index.html')) | url }}" class="logo"><span class="dot">●</span><span class="logo-word">هكو<span class="logo-tail">له</span></span></a>
      <nav class="main-nav" id="main-nav">
        {% if lang == "en" %}
        <a href="{{ '/en/index.html' | url }}"{% if navActive == "home" %} class="active"{% endif %}>{{ t.nav_home }}</a>
        <a href="{{ '/en/bakeries.html' | url }}"{% if navActive == "bakeries" %} class="active"{% endif %}>Bakeries</a>
        {% else %}
        <a href="{{ '/index.html' | url }}"{% if navActive == "home" %} class="active"{% endif %}>{{ t.nav_home }}</a>
        {% for entry in sections %}
        <a href="{{ ('/' + entry.slug + '.html') | url }}"{% if navActive == entry.slug %} class="active"{% endif %}>{{ entry.navLabel }}</a>
        {% endfor %}
        <a href="{{ '/favorites.html' | url }}"{% if navActive == "favorites" %} class="active"{% endif %}>{{ t.nav_favorites }}</a>
        <a href="{{ '/picker.html' | url }}"{% if navActive == "picker" %} class="active"{% endif %}>{{ t.nav_picker }}</a>
        {% endif %}
      </nav>
      <a class="lang-switch" href="{{ (langSwitchUrl or ('/index.html' if lang == 'en' else '/en/index.html')) | url }}">{{ t.lang_switch }}</a>
      <button class="theme-toggle" aria-label="{{ t.theme_toggle_aria }}" title="{{ t.theme_toggle }}"></button>
      <button class="sound-toggle" aria-label="{{ t.sound_off }}" title="{{ t.sound_off }}">🔇</button>
      <button class="nav-toggle" aria-label="{{ t.nav_toggle_open }}" aria-expanded="false" aria-controls="main-nav">☰</button>
    </div>
  </header>

  <main class="container" id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>{{ t.footer_copyright }}</span>
      <div class="footer-links">
        <a href="{{ ('/en/about.html' if lang == 'en' else '/about.html') | url }}">{{ t.footer_about }}</a>
        <a href="{{ ('/en/contact.html' if lang == 'en' else '/contact.html') | url }}">{{ t.footer_contact }}</a>
        <a href="{{ ('/en/privacy-policy.html' if lang == 'en' else '/privacy-policy.html') | url }}">{{ t.footer_privacy }}</a>
        <a href="{{ ('/en/terms.html' if lang == 'en' else '/terms.html') | url }}">{{ t.footer_terms }}</a>
      </div>
    </div>
  </footer>

  <div class="cookie-banner" id="cookie-banner" role="region" aria-label="{{ t.cookie_accept }}">
    <p>{{ t.cookie_text_html | replace("{privacyUrl}", (('/en/privacy-policy.html' if lang == 'en' else '/privacy-policy.html') | url)) | safe }}</p>
    <button type="button" class="btn cookie-accept" id="cookie-accept">{{ t.cookie_accept }}</button>
  </div>

  <div class="adblock-notice" id="adblockNotice" role="region" aria-label="{{ t.adblock_close }}">
    <button type="button" class="adblock-notice-close" id="adblockNoticeClose" aria-label="{{ t.adblock_close }}">✕</button>
    <p>{{ t.adblock_text }}</p>
  </div>

  <div class="daily-pick-reminder" id="dailyPickReminder" role="region" aria-label="{{ t.daily_pick_close }}">
    <button type="button" class="daily-pick-reminder-close" id="dailyPickReminderClose" aria-label="{{ t.daily_pick_close }}">✕</button>
    <p>{{ t.daily_pick_text_html | replace("{homeUrl}", (('/en/index.html' if lang == 'en' else '/index.html') | url)) | safe }}</p>
  </div>

  <script>
    window.PUSH_CONFIG = { workerUrl: {{ push.workerUrl | json | safe }}, vapidPublicKey: {{ push.vapidPublicKey | json | safe }} };
    window.SITE_LANG = {{ lang | json | safe }};
    window.I18N = {{ i18n | json | safe }};
  </script>
  <script src="{{ '/js/data.js' | url }}?v={{ buildVersion }}"></script>
  <script src="{{ '/js/main.js' | url }}?v={{ buildVersion }}"></script>
  {% if section %}<script>renderSection("{{ section }}");</script>{% endif %}
  {% if isFavoritesPage %}<script>renderFavoritesPage();</script>{% endif %}
  {% if navActive == "picker" %}<script>initRandomPicker();</script>{% endif %}
  {% if navActive == "home" %}<script>renderFeaturedPick();initPushNotifications();renderTrendingSection();renderExploreProgress();</script>{% endif %}
</body>
</html>
