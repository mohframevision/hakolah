<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>
    (function () {
      try {
        var pref = localStorage.getItem("site_theme_pref");
        if (pref === "light" || pref === "dark") {
          document.documentElement.setAttribute("data-theme", pref);
        }
      } catch (e) {}
    })();
  </script>
  {% set metaDescription = description or desc %}
  {% set pageUrl = site.origin + (page.url | url) %}
  {% set ogType = "article" if sectionSlug else "website" %}
  {% set ogImageUrl = site.origin + image if image else site.origin + ('/assets/og-image.png' | url) %}
  <title>{{ title }}</title>
  {% if metaDescription %}<meta name="description" content="{{ metaDescription }}" />{% endif %}
  {% if noindex %}<meta name="robots" content="noindex, nofollow" />{% endif %}
  <link rel="canonical" href="{{ pageUrl }}" />
  <meta name="theme-color" content="#2563eb" />

  <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}" />
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/favicon-32x32.png' | url }}" />
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/favicon-16x16.png' | url }}" />
  <link rel="shortcut icon" href="{{ '/assets/favicon.ico' | url }}" />
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/apple-touch-icon.png' | url }}" />
  <link rel="manifest" href="{{ '/assets/site.webmanifest' | url }}" />

  <meta property="og:type" content="{{ ogType }}" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:locale" content="{{ site.locale }}" />
  <meta property="og:url" content="{{ pageUrl }}" />
  <meta property="og:title" content="{{ title }}" />
  {% if metaDescription %}<meta property="og:description" content="{{ metaDescription }}" />{% endif %}
  <meta property="og:image" content="{{ ogImageUrl }}" />
  {% if not image %}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {% endif %}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  {% if metaDescription %}<meta name="twitter:description" content="{{ metaDescription }}" />{% endif %}
  <meta name="twitter:image" content="{{ ogImageUrl }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}?v={{ buildVersion }}" />
  {% if adsense.publisherId %}
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ adsense.publisherId }}" crossorigin="anonymous"></script>
  {% endif %}
  {% if analytics.measurementId %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ analytics.measurementId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag("js", new Date());
    gtag("config", "{{ analytics.measurementId }}");
  </script>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": {{ site.name | json | safe }},
        "url": {{ (site.origin + ('/index.html' | url)) | json | safe }},
        "inLanguage": "ar"
      },
      {
        "@type": "Organization",
        "name": {{ site.name | json | safe }},
        "url": {{ (site.origin + ('/index.html' | url)) | json | safe }},
        "logo": {{ (site.origin + ('/assets/android-chrome-512x512.png' | url)) | json | safe }}
      }
    ]
  }
  </script>
</head>
<body>

  <a href="#main-content" class="skip-link">تخطّي إلى المحتوى</a>

  <header class="site-header">
    <div class="header-inner">
      <a href="{{ '/index.html' | url }}" class="logo"><span class="dot">●</span><span class="logo-word">هكو<span class="logo-tail">له</span></span></a>
      <nav class="main-nav" id="main-nav">
        <a href="{{ '/index.html' | url }}"{% if navActive == "home" %} class="active"{% endif %}>الرئيسية</a>
        {% for entry in sections %}
        <a href="{{ ('/' + entry.slug + '.html') | url }}"{% if navActive == entry.slug %} class="active"{% endif %}>{{ entry.navLabel }}</a>
        {% endfor %}
        <a href="{{ '/favorites.html' | url }}"{% if navActive == "favorites" %} class="active"{% endif %}>المفضلة</a>
        <a href="{{ '/picker.html' | url }}"{% if navActive == "picker" %} class="active"{% endif %}>🎲 اختار لي</a>
      </nav>
      <button class="theme-toggle" aria-label="تبديل المظهر (فاتح/داكن/تلقائي)" title="تبديل المظهر"></button>
      <button class="sound-toggle" aria-label="تفعيل المؤثرات الصوتية" title="المؤثرات الصوتية">🔇</button>
      <button class="nav-toggle" aria-label="فتح القائمة" aria-expanded="false" aria-controls="main-nav">☰</button>
    </div>
  </header>

  <main class="container" id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>© 2026 هكوله. جميع الحقوق محفوظة.</span>
      <div class="footer-links">
        <a href="{{ '/about.html' | url }}">عن الموقع</a>
        <a href="{{ '/contact.html' | url }}">تواصل معنا</a>
        <a href="{{ '/privacy-policy.html' | url }}">سياسة الخصوصية</a>
        <a href="{{ '/terms.html' | url }}">شروط الاستخدام</a>
      </div>
    </div>
  </footer>

  <div class="cookie-banner" id="cookie-banner" role="region" aria-label="إشعار ملفات تعريف الارتباط">
    <p>نستخدم ملفات تعريف الارتباط (Cookies) لحفظ تفضيلاتك (كالمظهر والمفضلة) ولعرض إعلانات Google. بمتابعة تصفح الموقع فأنت توافق على <a href="{{ '/privacy-policy.html' | url }}">سياسة الخصوصية</a>.</p>
    <button type="button" class="btn cookie-accept" id="cookie-accept">موافق</button>
  </div>

  <div class="adblock-notice" id="adblockNotice" role="region" aria-label="ملاحظة عن مانع الإعلانات">
    <button type="button" class="adblock-notice-close" id="adblockNoticeClose" aria-label="إغلاق">✕</button>
    <p>🙏 لاحظنا إنك تستخدم مانع إعلانات. الموقع مجاني بالكامل وبدون أي رسوم عليك، ودخل بسيط من الإعلانات يساعدنا نكمل ونطوّر الموقع. لو تقدر تعطّله لهذا الموقع تحديداً، نقدّر ذلك ❤️</p>
  </div>

  <script>
    window.PUSH_CONFIG = { workerUrl: {{ push.workerUrl | json | safe }}, vapidPublicKey: {{ push.vapidPublicKey | json | safe }} };
  </script>
  <script src="{{ '/js/data.js' | url }}?v={{ buildVersion }}"></script>
  <script src="{{ '/js/main.js' | url }}?v={{ buildVersion }}"></script>
  {% if section %}<script>renderSection("{{ section }}");</script>{% endif %}
  {% if isFavoritesPage %}<script>renderFavoritesPage();</script>{% endif %}
  {% if navActive == "picker" %}<script>initRandomPicker();</script>{% endif %}
  {% if navActive == "home" %}<script>renderFeaturedPick();initPushNotifications();renderTrendingSection();renderExploreProgress();</script>{% endif %}
</body>
</html>
