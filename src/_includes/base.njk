<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>
    (function () {
      try {
        var pref = localStorage.getItem("site_theme_pref");
        if (pref === "light" || pref === "dark") {
          document.documentElement.setAttribute("data-theme", pref);
        }
      } catch (e) {}
    })();
  </script>
  <title>{{ title }}</title>
  {% if description %}<meta name="description" content="{{ description }}" />{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/style.css?v={{ buildVersion }}" />
  {% if adsense.publisherId %}
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ adsense.publisherId }}" crossorigin="anonymous"></script>
  {% endif %}
</head>
<body>

  <header class="site-header">
    <div class="header-inner">
      <a href="index.html" class="logo"><span class="dot">●</span><span class="logo-word">هكو<span class="logo-tail">له</span></span></a>
      <button class="theme-toggle" aria-label="تبديل المظهر (فاتح/داكن/تلقائي)" title="تبديل المظهر"></button>
      <button class="nav-toggle" aria-label="فتح القائمة">☰</button>
      <nav class="main-nav">
        <a href="index.html"{% if navActive == "home" %} class="active"{% endif %}>الرئيسية</a>
        {% for entry in sections %}
        <a href="{{ entry.slug }}.html"{% if navActive == entry.slug %} class="active"{% endif %}>{{ entry.navLabel }}</a>
        {% endfor %}
        <a href="favorites.html"{% if navActive == "favorites" %} class="active"{% endif %}>المفضلة</a>
      </nav>
    </div>
  </header>

  <main class="container">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>© 2026 هكوله. جميع الحقوق محفوظة.</span>
      <div class="footer-links">
        <a href="about.html">عن الموقع</a>
        <a href="privacy-policy.html">سياسة الخصوصية</a>
      </div>
    </div>
  </footer>

  <script src="js/data.js?v={{ buildVersion }}"></script>
  <script src="js/main.js?v={{ buildVersion }}"></script>
  {% if section %}<script>renderSection("{{ section }}");</script>{% endif %}
  {% if isFavoritesPage %}<script>renderFavoritesPage();</script>{% endif %}
</body>
</html>
