<!DOCTYPE html>
{% from "icon.njk" import icon, iconSprite %}
{% set lang = lang or "ar" %}
{% set t = i18n[lang] %}
{# دليل الأماكن انتقل إلى توريلو (torilu.js): صفحاته هنا صفحة تحويل فقط #}
{% set toriluTo = page.url | toriluUrl %}
{% set toriluHome = "https://torilu.com/" + ("en/index.html" if lang == "en" else "") %}
{% if toriluTo %}{% include "torilu-stub.njk" %}{% else %}
<html lang="{{ lang }}" dir="{{ 'ltr' if lang == 'en' else 'rtl' }}">
<head>
  <meta charset="UTF-8" />
  {#
    Content-Security-Policy — GitHub Pages ما يسمح بضبط HTTP headers مخصصة،
    فهذا الـ meta tag هو الطريقة الوحيدة المتاحة (ملاحظة: frame-ancestors
    وreport-uri ما يشتغلوا عبر meta، بس باقي التوجيهات تشتغل صح).
    كل التوجيهات مبنية على الأصول الفعلية اللي يتصل بها الموقع فقط:
    - self: كل شيء عندنا (CSS/JS/صور/بيانات مبنية).
    - الخط مستضاف عندنا (assets/fonts) فما عاد يحتاج أي نطاق خارجي.
    - لا خادم ولا تتبّع ولا إعلانات (قرار 2026-11-04): كل الطلبات لنفس الموقع، عدا استثناءين:
      api.web3forms.com لنموذج التواصل، وyoutube-nocookie.com بـframe-src (تحت).
    - style-src-attr 'unsafe-inline': سمات style المضمّنة بقوالبنا وأكوادنا (متغيرات CSS،
      أبعاد محسوبة). مقصور على سمات style فقط؛ لا يسمح بعناصر <style> ولا ملفات CSS خارجية.
    - object-src none: يمنع أي Flash/plugin قديم (ناقل هجمات كلاسيكي).
    - base-uri self: يمنع حقن <base> لتغيير مسار كل الروابط النسبية بالصفحة.
    ما فيه أي unsafe-inline بـ script-src إطلاقاً — وهذا هو الأهم أمنياً
    (الحماية الفعلية من XSS). كل الأكواد المضمّنة سابقاً (تفضيل المظهر،
    إعدادات اللغة، gtag، استدعاءات كل صفحة) نُقلت لملفات JS خارجية أو لعنصر
    بيانات <script type="application/json"> (غير قابل للتنفيذ أصلاً).


    frame-src يضم أيضاً youtube-nocookie.com — لفيديوهات مقالات الأماكن
    (حقل video بلوحة التحكم)، النسخة الخاصة بالخصوصية من يوتيوب فما تُحمَّل
    كوكيز تتبّع قبل ما الزائر يضغط تشغيل.

    media-src 'self' blob: — تجربة الموسيقى تولّد ملف فيديو/صوت بالمتصفح
    وتعطيه رابط blob: من نفس الصفحة. بدون هذا التوجيه يرجع المتصفح لـ
    default-src ويحجب تشغيل الملف المولَّد محلياً. لا يفتح أي مصدر خارجي:
    روابط blob: ينشئها كودنا نفسه بنفس الأصل.
  #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://api.web3forms.com; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; manifest-src 'self'; worker-src 'self'; media-src 'self' blob:" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {# ملف خارجي (وليس سكربت مضمّن) عمداً — يسمح بسياسة CSP صارمة script-src
     بدون unsafe-inline. يُحمَّل بدون defer/async فيشتغل قبل أول رسم للصفحة
     (يمنع "وميض" المظهر الفاتح قبل تطبيق المظهر الداكن المحفوظ) #}
  <script src="{{ '/js/theme-init.js' | url }}"></script>
  {% set metaDescription = description or desc %}
  {% set pageUrl = site.origin + (page.url | url) %}
  {% set ogType = "article" if sectionSlug else "website" %}
  {% set ogImageUrl = site.origin + image if image else site.origin + ('/assets/og-image.png' | url) %}
  <title>{{ title }}</title>
  {% if metaDescription %}<meta name="description" content="{{ metaDescription }}" />{% endif %}
  {% if noindex %}<meta name="robots" content="noindex, nofollow" />{% endif %}
  <link rel="canonical" href="{{ pageUrl }}" />
  {% if langSwitchUrl %}
  {% set altUrl = site.origin + (langSwitchUrl | url) %}
  <link rel="alternate" hreflang="{{ lang }}" href="{{ pageUrl }}" />
  <link rel="alternate" hreflang="{{ 'ar' if lang == 'en' else 'en' }}" href="{{ altUrl }}" />
  <link rel="alternate" hreflang="x-default" href="{{ pageUrl if lang == 'ar' else altUrl }}" />
  {% endif %}
  <meta name="theme-color" content="{{ theme.primary or '#1b4d3e' }}" />

  <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}" />
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/favicon-32x32.png' | url }}" />
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/favicon-16x16.png' | url }}" />
  <link rel="shortcut icon" href="{{ '/assets/favicon.ico' | url }}" />
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/apple-touch-icon.png' | url }}" />
  <link rel="manifest" href="{{ (('/assets/site-en.webmanifest' if lang == 'en' else '/assets/site.webmanifest')) | url }}" />
  {# آيفون يتجاهل أغلب ملف المانيفست — بلا هالوسمين يفتح المختصر بشريط
     متصفح كامل بدل ما يفتح كتطبيق مستقل #}
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="{{ 'Hakolah' if lang == 'en' else 'هكوله' }}" />

  <meta property="og:type" content="{{ ogType }}" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:locale" content="{{ 'en_US' if lang == 'en' else site.locale }}" />
  {% if langSwitchUrl %}<meta property="og:locale:alternate" content="{{ site.locale if lang == 'en' else 'en_US' }}" />{% endif %}
  <meta property="og:url" content="{{ pageUrl }}" />
  <meta property="og:title" content="{{ title }}" />
  {% if metaDescription %}<meta property="og:description" content="{{ metaDescription }}" />{% endif %}
  <meta property="og:image" content="{{ ogImageUrl }}" />
  {% if not image %}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {% endif %}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  {% if metaDescription %}<meta name="twitter:description" content="{{ metaDescription }}" />{% endif %}
  <meta name="twitter:image" content="{{ ogImageUrl }}" />

  {# الخط صار مستضافاً عندنا (@font-face بـ style.css) — نُحمّله مسبقاً لأنه
     يُكتشف متأخراً داخل ملف CSS، فبلا preload يتأخر ظهور النص بخطه #}
  <link rel="preload" href="{{ ('/assets/fonts/cairo-latin.woff2' if lang == 'en' else '/assets/fonts/cairo-arabic.woff2') | url }}" as="font" type="font/woff2" crossorigin />
  {# صورة العنصر الرئيسية (LCP بصفحات التفاصيل) — أولوية تحميل عالية لأنها
     غالباً أكبر عنصر مرئي بالصفحة. لا أثر مرئي، ملف عادي مسبقاً في <img>
     بجسم الصفحة (detail-item.njk)، هذا فقط يبدأ تحميله أبكر. #}
  {% if image %}<link rel="preload" as="image" href="{{ image }}" fetchpriority="high" />{% endif %}
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}?v={{ buildVersion }}" />
  {# ملف تنسيق خاص بصفحة (مثل menu.css لقوالب المنيو وخطوطها) — بس بالصفحات اللي تطلبه #}
  {% if pageCss %}<link rel="stylesheet" href="{{ ('/css/' + pageCss + '.css') | url }}?v={{ buildVersion }}" />{% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": {{ site.name | json | safe }},
        "url": {{ (site.origin + ('/index.html' | url)) | json | safe }},
        "inLanguage": "{{ lang }}"
      },
      {
        "@type": "Organization",
        "name": {{ site.name | json | safe }},
        "url": {{ (site.origin + ('/index.html' | url)) | json | safe }},
        "logo": {{ (site.origin + ('/assets/android-chrome-512x512.png' | url)) | json | safe }}
      }{% if navActive and navActive != "home" %},
      {# مسار الصفحة — قوقل يعرضه بنتائج البحث بدل الرابط الخام،
         فيصير أوضح وأسهل للنقر (الرئيسية > مطاعم البحرين) #}
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ t.nav_home | json | safe }},
            "item": {{ (site.origin + (('/en/index.html' if lang == 'en' else '/index.html') | url)) | json | safe }}
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ (title | replace(" | هكوله", "") | replace(" | Hakolah", "")) | json | safe }},
            "item": {{ pageUrl | json | safe }}
          }
        ]
      }{% endif %}
    ]
  }
  </script>
</head>
<body>

  <a href="#main-content" class="skip-link" data-nosnippet>{{ t.skip_to_content }}</a>

  <header class="site-header" data-nosnippet>
    <div class="header-inner">
      <a href="{{ (('/en/index.html' if lang == 'en' else '/index.html')) | url }}" class="logo"><span class="dot">●</span>{% if lang == "en" %}<span class="logo-word">Hako<span class="logo-tail">lah</span></span>{% else %}<span class="logo-word">هكو<span class="logo-tail">له</span></span>{% endif %}</a>
      <nav class="main-nav" id="main-nav">
        {# الرئيسية (الشعار والشريط السفلي) وبوزون (أيقونته والشريط السفلي) لا تتكرّر هنا؛
           والأماكن في الشريط السفلي على الشاشات التي تظهر فيها هذه القائمة #}
        {% for entry in sections %}{% if not entry.creators and not (('/' + entry.slug + '.html') | toriluUrl) %}
        <a href="{{ (('/en/' if lang == 'en' else '/') + entry.slug + '.html') | url }}"{% if navActive == entry.slug %} class="active" aria-current="page"{% endif %}>{{ entry.navLabel_en if lang == 'en' else entry.navLabel }}</a>
        {% endif %}{% endfor %}
        <a class="nav-wide" href="{{ toriluHome }}">{{ 'Places guide' if lang == 'en' else 'دليل الأماكن' }}</a>
        {% set onCreators = navActive in ["creators", "links-tools", "ai-experiments"] %}
        <a href="{{ (('/en/creators.html' if lang == 'en' else '/creators.html')) | url }}"{% if onCreators %} class="active" aria-current="page"{% endif %}>{{ 'For Creators' if lang == 'en' else 'للمبدعين' }}</a>
      </nav>
      <div class="header-actions">
        <a class="icon-btn{% if navActive == "sounds" %} active{% endif %}"{% if navActive == "sounds" %} aria-current="page"{% endif %} href="{{ (('/en/sounds.html' if lang == 'en' else '/sounds.html')) | url }}" title="{{ t.nav_sounds }}" aria-label="{{ t.nav_sounds }}">{{ icon("music") }}</a>
        {% set dilmoLabel = "Boson" if lang == "en" else "بوزون" %}<a class="icon-btn{% if navActive == "dilmo" %} active{% endif %}"{% if navActive == "dilmo" %} aria-current="page"{% endif %} href="{{ (("/en/dilmo.html" if lang == "en" else "/dilmo.html")) | url }}" title="{{ dilmoLabel }}" aria-label="{{ dilmoLabel }}">{{ icon("dilmo") }}</a>
        <span class="header-divider" aria-hidden="true"></span>
        {# على الشاشات الضيقة نعرض الاختصار بدل الاسم الكامل عشان يضل الهيدر بصف واحد #}
        <a class="lang-switch" href="{{ (langSwitchUrl or ('/index.html' if lang == 'en' else '/en/index.html')) | url }}" title="{{ t.lang_switch }}" aria-label="{{ t.lang_switch }}"><span class="lang-full">{{ t.lang_switch }}</span><span class="lang-short" aria-hidden="true">{{ t.lang_switch_short }}</span></a>
        {# مخفي افتراضياً — يظهره الجافاسكربت فقط لو المتصفح أعلن فعلاً إن
           الموقع قابل للتثبيت (beforeinstallprompt). زر تثبيت لا يعمل أسوأ
           من غيابه #}
        <button class="icon-btn install-btn" id="installBtn" hidden title="{{ t.install_app }}" aria-label="{{ t.install_app }}">{{ icon("download") }}</button>
        <button class="theme-toggle" aria-label="{{ t.theme_toggle_aria }}" title="{{ t.theme_toggle }}"></button>
        <button class="sound-toggle" aria-label="{{ t.sound_off }}" title="{{ t.sound_off }}">{{ icon("volume-off") }}</button>
        <button class="nav-toggle" aria-label="{{ t.nav_toggle_open }}" aria-expanded="false" aria-controls="main-nav">{{ icon("menu") }}</button>
      </div>
    </div>
  </header>

  <main class="container" id="main-content">
    {{ content | safe }}
    {% if section %}{{ iconSprite() }}{% endif %}
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>{{ t.footer_copyright }}</span>
      <div class="footer-links">
        <a href="{{ ('/en/about.html' if lang == 'en' else '/about.html') | url }}">{{ t.footer_about }}</a>
        <a href="{{ ('/en/contact.html' if lang == 'en' else '/contact.html') | url }}">{{ t.footer_contact }}</a>
        <a href="{{ ('/en/privacy-policy.html' if lang == 'en' else '/privacy-policy.html') | url }}">{{ t.footer_privacy }}</a>
        <a href="{{ ('/en/terms.html' if lang == 'en' else '/terms.html') | url }}">{{ t.footer_terms }}</a>
        {% if social.youtubeUrl %}<a href="{{ social.youtubeUrl }}" target="_blank" rel="noopener noreferrer">{{ t.footer_youtube }}</a>{% endif %}
        {% if social.whatsappUrl %}<a href="{{ social.whatsappUrl }}" target="_blank" rel="noopener noreferrer">{{ t.footer_whatsapp }}</a>{% endif %}
      </div>
    </div>
  </footer>

  {# شريط سفلي بستايل التطبيقات — يظهر بنفس نقطة الكسر اللي يتحول فيها الهيدر
     لقائمة همبرغر (1200px)، ويكرر نفس وجهات أيقونات الهيدر (لا صفحات جديدة) #}
  <nav class="bottom-nav" data-nosnippet aria-label="{{ t.nav_home }}">
    <a href="{{ (('/en/index.html' if lang == 'en' else '/index.html')) | url }}"{% if navActive == "home" %} class="active" aria-current="page"{% endif %}>
      <span class="bottom-nav-icon">{{ icon("home", 22) }}</span><span>{{ t.nav_home }}</span>
    </a>
    <a href="{{ (('/en/sounds.html' if lang == 'en' else '/sounds.html')) | url }}"{% if navActive == "sounds" %} class="active" aria-current="page"{% endif %}>
      <span class="bottom-nav-icon">{{ icon("music", 22) }}</span><span>{{ t.nav_sounds_short }}</span>
    </a>
    <a href="{{ (("/en/dilmo.html" if lang == "en" else "/dilmo.html")) | url }}"{% if navActive == "dilmo" %} class="active" aria-current="page"{% endif %}>
      <span class="bottom-nav-icon">{{ icon("dilmo", 22) }}</span><span>{{ "Boson" if lang == "en" else "بوزون" }}</span>
    </a>
    <a href="{{ toriluHome }}">
      <span class="bottom-nav-icon">{{ icon("location-pin", 22) }}</span><span>{{ "Places" if lang == "en" else "الأماكن" }}</span>
    </a>
  </nav>


  {# إعدادات الصفحة كبيانات JSON (نوع application/json لا يُنفَّذ إطلاقاً، فما
     يحتاج أي استثناء بسياسة CSP). bootstrap.js يقرأها، وmain.js يشغّل دوال
     الصفحة المناسبة حسب page — بدل السكربتات المضمّنة اللي كانت هنا #}
  {# فقاعة الدعم (كازاسوق: معدّات ألعاب) تظهر بس بصفحات المبدعين — زائر دليل المطاعم/الكرك/الكراجات ما تناسب نيّته #}
  {% if navActive in ["creators", "links-tools", "ai-experiments"] %}
  {% if lang == "en" %}
  <button type="button" class="support-bubble" id="supportBubble" aria-label="Support Hakolah">🎮</button>
  <dialog class="support-card" id="supportCard" aria-labelledby="supportTitle">
    <button type="button" class="support-close" data-close aria-label="Close">✕</button>
    <div class="support-hero">
      <div class="support-emoji">🎮</div>
      <span class="support-tag">Support Hakolah</span>
      <h2 id="supportTitle">Shop at Cazasouq, support the site</h2>
      <p>Hakolah is free, and it stays free. If you're buying something anyway, buying it from <strong>Cazasouq</strong> through our link supports the site at no extra cost to you.</p>
    </div>
    <div class="support-body">
      <ul class="support-features">
        <li><span>🕹️</span>Gaming gear and equipment</li>
        <li><span>🛠️</span>Maintenance by a specialist team</li>
        <li><span>📦</span>International shipping to your door</li>
      </ul>
      <p class="support-quote">"I've bought from them myself and I recommend them."</p>
      <a class="support-go" href="https://cazasouq.idevaffiliate.com/692.html" target="_blank" rel="sponsored noopener">Shop at Cazasouq →</a>
      <p class="support-note">Affiliate link: Hakolah earns a small commission on your purchases.</p>
      <button type="button" class="support-hide" data-hide>Don't show this again</button>
    </div>
  </dialog>
  {% else %}
  <button type="button" class="support-bubble" id="supportBubble" aria-label="ادعم هكوله">🎮</button>
  <dialog class="support-card" id="supportCard" aria-labelledby="supportTitle">
    <button type="button" class="support-close" data-close aria-label="إغلاق">✕</button>
    <div class="support-hero">
      <div class="support-emoji">🎮</div>
      <span class="support-tag">ادعم هكوله</span>
      <h2 id="supportTitle">تسوّق من كازاسوق، وادعم الموقع</h2>
      <p>هكوله مجاني وسيبقى مجانياً. إذا كنت ستشتري شيئاً على أي حال، فشراؤك من <strong>كازاسوق</strong> عبر رابطنا يدعم الموقع دون أي تكلفة إضافية عليك.</p>
    </div>
    <div class="support-body">
      <ul class="support-features">
        <li><span>🕹️</span>معدات وأجهزة الألعاب</li>
        <li><span>🛠️</span>صيانة على يد فريق متخصص</li>
        <li><span>📦</span>شحن دولي حتى باب بيتك</li>
      </ul>
      <p class="support-quote">«اشتريت منهم بنفسي وأنصح بهم.»</p>
      <a class="support-go" href="https://cazasouq.idevaffiliate.com/692.html" target="_blank" rel="sponsored noopener">تسوّق من كازاسوق ←</a>
      <p class="support-note">رابط تسويق بالعمولة: يحصل هكوله على عمولة صغيرة من مشترياتك.</p>
      <button type="button" class="support-hide" data-hide>لا تظهر هذا مجدداً</button>
    </div>
  </dialog>
  {% endif %}
  {% endif %}
  <script type="application/json" id="site-config">
    {
      "lang": {{ lang | json | safe }},
      "menusUrl": {{ (('/js/menus.js' | url) + '?v=' + buildVersion) | json | safe }},
      "page": {
        "section": {{ (section or "") | json | safe }},
        "typeFilter": {{ (typeFilter or "") | json | safe }}
      },
      "i18n": { {{ lang | json | safe }}: {{ i18nJs[lang] | json | safe }} }
    }
  </script>
  <script src="{{ '/js/bootstrap.js' | url }}?v={{ buildVersion }}"></script>
  {# بيانات الأقسام: يقرأها فقط عرض القسم (main.js) وبحث بوزون — باقي الصفحات لا تحمّلها #}
  {% if section or pageScript == "dilmo" %}<script src="{{ '/js/data.js' | url }}?v={{ buildVersion }}"></script>{% endif %}
  <script src="{{ '/js/main.js' | url }}?v={{ buildVersion }}"></script>
  {# سكربت خاص بصفحة وحدة (مثل صوتيات هكوله) — ما ينزل مع بقية الصفحات #}
  {% if pageScript %}<script src="{{ ('/js/' + pageScript + '.js') | url }}?v={{ buildVersion }}"></script>{% endif %}
</body>
</html>
{% endif %}
