{#
  بطاقة عنصر تُطبع داخل HTML وقت البناء — الهدف الأساسي محركات البحث.

  قبل هذا، كل العناصر (105) كانت تُبنى بجافاسكربت بعد فتح الصفحة، فكود صفحة
  "مطاعم" ما كان فيه ولا اسم مطعم واحد. يعني من يبحث بقوقل عن اسم مطعم
  معيّن ما يوصل للموقع إطلاقاً.

  main.js يعيد بناء الشبكة بعد التحميل ويستبدل هذي البطاقات بنسخة تفاعلية
  (إعجاب/مفضلة/مشاركة/فلترة). فهذي النسخة عمداً بلا أزرار تفاعلية — تحتوي
  فقط ما يهم محرك البحث والزائر بدون جافاسكربت: الاسم، الوصف، التصنيفات،
  والروابط. والكلاسات نفسها عشان الشكل يكون مطابقاً قبل تدخّل جافاسكربت.
#}
{% from "icon.njk" import icon %}
{% macro card(entry, sectionSlug, lang, hasDetailPages, tagsEn, i18n, tagIcons) %}
{% set d = entry.data %}
{% set isEn = (lang == "en") %}
{% set title = (d.title_en or d.title) if isEn else d.title %}
{% set desc = (d.desc_en or d.desc) if isEn else d.desc %}
{% set t = i18n[lang or "ar"] %}
<div class="item-card{% if d.sponsored %} sponsored{% elif d.featured %} featured{% endif %}{% if d.verified %} verified{% endif %}">
  {% if d.image %}<img class="item-photo" src="{{ d.image }}" alt="{{ title }}" loading="lazy" decoding="async" />{% endif %}
  {# شارة واحدة بس — الشارتان بنفس الموضع المطلق فتتراكبان. "ممول" لها
     الأولوية: الإفصاح عن الإعلان المدفوع أهم من وسم "مميز" #}
  {% if d.sponsored %}<span class="sponsored-badge">{{ t.sponsored_badge }}</span>
  {% elif d.featured %}<span class="featured-badge">{{ t.featured_badge }}</span>{% endif %}
  <div class="item-body">
    <div class="item-top">
      <span class="item-icon">{{ d.icon or "⭐" }}</span>
    </div>
    <h3>{{ title }}{% if d.verified %} <span class="verified-badge">{{ t.verified_badge }}</span>{% endif %}{% if d.liked %} <span class="liked-badge">{{ t.liked_badge }}</span>{% endif %}{% if d.video %} <span class="video-badge">{{ t.video_badge }}</span>{% endif %}</h3>
    <p class="item-desc">{{ desc }}</p>
    {%- set hours = (d.hours_en or d.hours) if isEn else d.hours %}
    {%- if hours %}<p class="item-hours">{{ icon("schedule", 16) }} {{ hours }}</p>{%- endif %}
    <div class="item-meta">
      {%- for tag in (d.categories or []).concat(d.categoriesCustom or []) %}
      <span class="tag">{% if tagIcons[tag] %}<span class="tag-icon">{{ tagIcons[tag] }}</span>{% endif %}{{ (tagsEn[tag] or tag) if isEn else tag }}</span>
      {%- endfor %}
    </div>
    {#- مصدر اللحم: <details> أصلية بدل زر بجافاسكربت — تعطي زراً حقيقياً
        (summary) ويبقى النص داخل HTML فتقرأه محركات البحث، وهذا أصلاً الهدف
        من الحقل. يظهر فقط للعناصر اللي فيها مصدر متحقَّق منه فعلاً. -#}
    {%- set meat = d.meatSource %}
    {%- if meat and meat.text %}
    <details class="meat-source">
      <summary>🥩 {{ t.meat_source_label }}</summary>
      <p class="meat-source-text">{{ (meat.text_en or meat.text) if isEn else meat.text }}</p>
      <p class="meat-source-meta">
        {%- if meat.via == "asked" %}{{ t.meat_source_via_asked }}
        {%- elif meat.via == "instagram" %}{{ t.meat_source_via_instagram }}
        {%- elif meat.via == "menu" %}{{ t.meat_source_via_menu }}{% endif %}
        {%- if meat.checked %} · {{ t.meat_source_checked }}: <span dir="ltr">{{ meat.checked | isoDate }}</span>{% endif %}
      </p>
    </details>
    {%- endif %}
    {#- قائمة الطعام التفاعلية: نسخة <details> بلا جافاسكربت هنا (تقرأها
        محركات البحث)، وmain.js يستبدلها ببطاقة منبثقة متحركة بعد التحميل —
        نفس مبدأ مصدر اللحم أعلاه، اسم وسعر بس بلا صور (قرار صريح). -#}
    {%- set menuItems = d.menuItems or [] %}
    {%- if menuItems.length %}
    <details class="menu-list">
      <summary>📋 {{ t.link_menu }}</summary>
      <ul class="menu-items">
        {%- for mi in menuItems %}
        <li><span class="menu-item-name">{{ (mi.name_en or mi.name) if isEn else mi.name }}</span>{% if mi.price %}<span class="menu-item-price">{{ mi.price }}</span>{% endif %}</li>
        {%- endfor %}
      </ul>
    </details>
    {%- endif %}
    <div class="item-actions">
      {%- if hasDetailPages or d.hasDetailPage %}
      <a class="btn" href="{{ (('/en/' if isEn else '/') + sectionSlug + '/' + (d.slug_en if (isEn and d.slug_en) else entry.fileSlug) + '.html') | url }}">{{ icon("menu-book", 16) }} {{ t.read_details }}</a>
      {%- else %}
      {%- set links = d.links or {} %}
      {%- set primary = "website" if links.website else ("phone" if links.phone else ("maps" if links.maps else ("instagram" if links.instagram else "menu"))) %}
      {%- if links.website %}<a class="btn{{ '' if primary == 'website' else ' secondary' }}" href="{{ links.website }}" target="_blank" rel="noopener noreferrer">{{ icon("language", 16) }} {{ ((d.cta_en or d.cta) if isEn else d.cta) or t.link_website }}</a>{% endif %}
      {%- if links.phone %}<a class="btn{{ '' if primary == 'phone' else ' secondary' }}" href="tel:{{ links.phone.split(',')[0] }}">{{ icon("call", 16) }} {{ t.link_phone }}</a>{% endif %}
      {%- if links.maps %}<a class="btn{{ '' if primary == 'maps' else ' secondary' }}" href="{{ links.maps }}" target="_blank" rel="noopener noreferrer">{{ icon("location-pin", 16) }} {{ t.link_maps }}</a>{% endif %}
      {%- if links.instagram %}<a class="btn{{ '' if primary == 'instagram' else ' secondary' }}" href="{{ links.instagram }}" target="_blank" rel="noopener noreferrer">{{ icon("photo-camera", 16) }} {{ t.link_instagram }}</a>{% endif %}
      {%- if links.menu and not menuItems.length %}<a class="btn{{ '' if primary == 'menu' else ' secondary' }}" href="{{ links.menu }}" target="_blank" rel="noopener noreferrer">{{ icon("menu-book", 16) }} {{ t.link_menu }}</a>{% endif %}
      {%- endif %}
    </div>
  </div>
</div>
{% endmacro %}
