---
pagination:
  data: "toolGroups"
  size: 1
  alias: "group"
layout: "base.njk"
eleventyComputed:
  permalink: "links-tools/{{ group.slug }}.html"
  title: "{{ group.title | safe }} | هكوله"
  description: "{{ group.intro | safe }}"
  navActive: "links-tools"
  section: "links-tools"
  typeFilter: "{{ group.label | safe }}"
  langSwitchUrl: "/en/links-tools/{{ group.slug }}.html"
---
{# نفس نمط car-shop-type.njk: صفحة لكل مجموعة، main.js يفلتر بالتاج (typeFilter) #}
{% set t = i18n[lang or "ar"] %}
{% import "item-card.njk" as cards %}
<div class="breadcrumb">
  <a href="{{ '/index.html' | url }}">{{ t.nav_home }}</a> /
  <a href="{{ '/links-tools.html' | url }}">روابط وأدوات</a> /
  {{ group.label }}
</div>
<section class="page-header">
  <h1><span aria-hidden="true">{{ group.icon }}</span> {{ group.title }}</h1>
  <p>{{ group.intro }}</p>
  {% if group.guide %}<p class="tool-guide-link">📖 <a href="{{ ('/guides/' + group.guide + '.html') | url }}">اقرأ الدليل: كيف تختار البرنامج المناسب</a></p>{% endif %}
</section>

{% if group.picks.length %}
<section class="tool-picks" aria-label="اختيارنا السريع">
  <h2>اختيارنا السريع</h2>
  <ul>
  {%- for p in group.picks %}
    <li>{{ p[0] }} <b><bdi>{{ p[1] }}</bdi></b></li>
  {%- endfor %}
  </ul>
</section>
{% endif %}

<input type="text" class="search-box" placeholder="ابحث في {{ group.label }}…" aria-label="البحث في {{ group.label }}" />
<div class="filters"></div>

<div class="card-grid">
{%- for entry in (collections['links-tools'] or []) %}
{%- if entry.data.group == group.slug %}
{{ cards.card(entry, "links-tools", "ar", false, tags_en, i18n, tag_icons, loop.index0) }}
{%- endif %}
{%- endfor %}
</div>

<nav class="tool-groups-more" aria-label="مجموعات أخرى">
  <h2>مجموعات أخرى</h2>
  <div class="chip-row">
  {%- for g in toolGroups %}{% if g.slug != group.slug %}
    <a class="filter-chip" href="{{ ('/links-tools/' + g.slug + '.html') | url }}"><span aria-hidden="true">{{ g.icon }}</span> {{ g.label }}</a>
  {%- endif %}{% endfor %}
  </div>
</nav>
