---
pagination:
  data: "sections"
  size: 1
  alias: "sectionEntry"
layout: "base.njk"
eleventyComputed:
  permalink: "{{ sectionEntry.slug }}.html"
  title: "{{ sectionEntry.title }} | هكوله"
  description: "{{ sectionEntry.description }}"
  navActive: "{{ sectionEntry.slug }}"
  section: "{{ sectionEntry.slug }}"
  langSwitchUrl: "/en/{{ sectionEntry.slug }}.html"
---
{# قوالب المحتوى تُعرض قبل القالب الأب (base.njk)، فمتغيّر t المعرّف هناك مو
   متاح هنا — لازم كل قالب يحتاج t يعرّفه بنفسه #}
{% set t = i18n[lang or "ar"] %}
{% import "item-card.njk" as cards %}
<div class="breadcrumb"><a href="{{ '/index.html' | url }}">{{ t.nav_home }}</a> / {{ sectionEntry.title }}</div>
<section class="page-header">
  <h1>{{ sectionEntry.icon }} {{ sectionEntry.title }}</h1>
  <p>{{ sectionEntry.description }}</p>
</section>

<input type="text" class="search-box" placeholder="{{ sectionEntry.searchPlaceholder }}" aria-label="البحث في {{ sectionEntry.title }}" />
<button type="button" class="near-me-btn" aria-pressed="false">{{ t.near_me }}</button>
<div class="filters"></div>

{# البطاقات مطبوعة هنا وقت البناء عشان محركات البحث تقرأ المحتوى فعلاً.
   main.js يستبدلها بنسخة تفاعلية بعد التحميل (فلترة/بحث/إعجاب/مفضلة). #}
<div class="card-grid">
{%- for entry in collections[sectionEntry.slug] %}
{{ cards.card(entry, sectionEntry.slug, "ar", sectionEntry.hasDetailPages, tags_en, i18n) }}
{%- endfor %}
</div>

{% include "cazasouq-promo.njk" %}
