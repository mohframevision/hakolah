<?xml version="1.0" encoding="utf-8"?>
<!-- مربع القسم بالرئيسية: سطح بزوايا 20dp وحد رفيع، وتموّج يتبع الزوايا -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_on_secondary">
    <item>
        <shape>
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
