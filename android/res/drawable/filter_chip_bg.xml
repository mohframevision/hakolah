<?xml version="1.0" encoding="utf-8"?>
<!-- نفس .filter-chip/.filter-chip.active بالموقع: حبة بحد رفيع افتراضياً،
     تمتلئ باللون الأساسي لما تكون فعّالة (state_activated) — ومغلّفة بتموّج
     لمس (ripple) أصلي عشان تعطي رد فعل لمسي زي بقية أزرار التطبيق -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_secondary">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/brand_primary" />
                    <corners android:radius="40dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface" />
                    <stroke android:width="1dp" android:color="@color/border" />
                    <corners android:radius="40dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
