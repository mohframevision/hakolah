<?xml version="1.0" encoding="utf-8"?>
<!-- نفس .settings-row بتطبيق محمد يدرس: حاوية بلون ثانٍ عن خلفية اللوحة نفسها
     + حد رفيع، تميّز كل صف إعداد بصرياً بدل نص عادي بلا حاوية -->
