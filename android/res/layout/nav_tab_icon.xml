<?xml version="1.0" encoding="utf-8"?>
<!-- نسخة أيقونات ثابتة (SVG/VectorDrawable) من nav_tab.xml — لشريط التنقّل
     السفلي الثابت بس (الرئيسية/اختار لي/المفضلة/الإعدادات). صف الأقسام
     الأفقي (بيانات ديناميكية من الموقع) يظل يستخدم nav_tab.xml بالإيموجي
     نفسه — أيقوناته تجيء من حقل "icon" بلوحة التحكم، ما فيها قائمة ثابتة
     نقدر نحوّلها لأيقونات متجهة بلا قاموس ربط هش. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/selectableItemBackgroundBorderless">

    <ImageView
        android:id="@+id/tabIcon"
        android:layout_width="56dp"
        android:layout_height="32dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tabLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:layout_marginTop="2dp" />
</LinearLayout>
