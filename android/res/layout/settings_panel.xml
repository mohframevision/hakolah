<?xml version="1.0" encoding="utf-8"?>
<!-- نفس شكل .settings-panel بتطبيق محمد يدرس بالضبط: رأس بعنوان + زر إغلاق
     دائري، وجسم مقسَّم لمجموعات (عنوان صغير كبير الأحرف خافت + صفوف بحاوية
     مميّزة) بدل قائمة نصوص عادية. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الإعدادات"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:drawableStart="@drawable/ic_settings_small"
            android:drawableTint="@color/text"
            android:drawablePadding="8dp" />

        <ImageView
            android:id="@+id/settingsCloseButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:src="@drawable/ic_close_small"
            android:tint="@color/text"
            android:background="@drawable/circle_border_bg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- مجموعة المظهر -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="المظهر"
            android:textAllCaps="true"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.04"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/settings_row_bg"
            android:padding="8dp">

            <TextView
                android:id="@+id/themeAuto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="تلقائي"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/filter_chip_bg"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/themeLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="فاتح"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/filter_chip_bg"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/themeDark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="داكن"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/filter_chip_bg"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- مجموعة الصوت -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الصوت"
            android:textAllCaps="true"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.04"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/settings_row_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="تفعيل الأصوات"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/soundSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
